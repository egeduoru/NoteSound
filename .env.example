# Static frontend remains on GitHub Pages. Empty API URL uses local licensed demo audio.
# Local dev automatically proxies discovery to port 3002. Public deployment needs its HTTPS server URL.
VITE_DISCOVERY_API_URL=
VITE_BASE_PATH=/NoteSound/
VITE_MUSIC_API_URL=
# Optional temporary rollback only; never used for audio extraction or hidden playback.
VITE_LEGACY_YOUTUBE_ENABLED=false
VITE_YOUTUBE_API_KEY=
