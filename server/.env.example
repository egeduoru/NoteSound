# Backend only: never copy BOT_TOKEN into VITE_* or GitHub frontend variables.
HOST=127.0.0.1
PORT=3001
APP_ORIGINS=https://egeduoru.github.io,http://127.0.0.1:5173
REQUIRE_TELEGRAM_AUTH=false
BOT_TOKEN=
CATALOG_SESSION_TTL_SECONDS=28800
HITMOZ_METADATA_ENABLED=false
HITMOZ_PLAYBACK_ENABLED=false
HITMOZ_PARSER_URL=
HITMOZ_PARSER_ALLOWED_HOSTS=
LICENSED_AUDIO_ALLOWED_HOSTS=
LICENSED_CATALOG_FILE=server/licenses.json
TELEGRAM_SEND_AUDIO_ENABLED=false

# SoundCloud's API terms require specific approval for aggregated streaming.
# KEEP FALSE unless you have obtained that approval from SoundCloud.
SOUNDCLOUD_CATALOG_APPROVED=false
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Public contact URL for MusicBrainz's mandatory identifiable User-Agent.
MUSICBRAINZ_CONTACT=https://github.com/your-account/NoteSound
